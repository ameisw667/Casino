{
  "color": {
    "canvas": {
      "base": { "$value": "#0B0E14", "$type": "color" },
      "deep": { "$value": "#05070A", "$type": "color" }
    },
    "gold": {
      "primary": { "$value": "#D4AF37", "$type": "color" },
      "secondary": { "$value": "#F59E0B", "$type": "color" }
    },
    "success": {
      "base": { "$value": "#10B981", "$type": "color" },
      "dark": { "$value": "#059669", "$type": "color" }
    },
    "error": {
      "base": { "$value": "#EF4444", "$type": "color" },
      "dark": { "$value": "#DC2626", "$type": "color" }
    },
    "border": {
      "glass": { "$value": "rgba(255,255,255,0.1)", "$type": "color" }
    }
  },
  "zIndex": {
    "modal": {
      "standard": { "$value": 1000, "$type": "number" },
      "crashTutorial": { "$value": 2000, "$type": "number" },
      "priority": { "$value": 5000, "$type": "number" }
    },
    "overlay": {
      "bigWin": { "$value": 9999, "$type": "number" },
      "loadingSplash": { "$value": 99999, "$type": "number" }
    }
  },
  "radius": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "12px", "$type": "dimension" },
    "xl": { "$value": "20px", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" }
  },
  "space": {
    "xs": { "$value": "clamp(0.25rem, 0.2rem + 0.25vw, 0.5rem)", "$type": "dimension" },
    "sm": { "$value": "clamp(0.5rem, 0.4rem + 0.5vw, 1rem)", "$type": "dimension" },
    "md": { "$value": "clamp(1rem, 0.8rem + 1vw, 2rem)", "$type": "dimension" },
    "lg": { "$value": "clamp(2rem, 1.5rem + 2vw, 4rem)", "$type": "dimension" },
    "xl": { "$value": "clamp(4rem, 3rem + 4vw, 8rem)", "$type": "dimension" }
  }
}
