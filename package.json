{
  "name": "casino",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port 3015",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:supabase": "tsx scripts/verify-supabase-env.ts",
    "economy-audit": "tsx scripts/economy-audit.ts",
    "sim:economy": "tsx scripts/economy-simulation.ts",
    "fraud-ml-scan": "tsx scripts/fraud-ml-scan.ts",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:reset": "npx supabase db reset",
    "supabase:migrations": "npx supabase migration list",
    "supabase:types": "npx supabase gen types typescript --local > src/types/database.types.ts",
    "supabase:diff": "npx supabase db diff --linked",
    "backup:run": "tsx scripts/backup-supabase.ts",
    "db:perf-audit": "tsx scripts/audit-query-performance.ts",
    "test:restore-drill": "tsx scripts/restore-drill.ts && vitest run src/lib/casino/__tests__/wallet-ledger-invariants.test.ts src/lib/security/__tests__/rls-defense-in-depth.test.ts src/lib/casino/__tests__/wallet-authority.test.ts src/lib/casino/__tests__/wallet-service-authority.test.ts",
    "design:generate": "tsx scripts/generate-design-assets.ts",
    "sentry:info": "sentry-cli info",
    "sentry:issues": "sentry-cli issues list -o berlin-agency -p javascript-nextjs --status unresolved",
    "vibe-check": "tsx scripts/vibe-check.ts",
    "observability:up": "docker compose -f docker/observability/docker-compose.yml up -d",
    "observability:down": "docker compose -f docker/observability/docker-compose.yml down",
    "loadtest:bet": "artillery run scripts/loadtest/bet-flow.artillery.yml",
    "github:repo": "gh repo view ameisw667/Casino --json nameWithOwner,isPrivate,defaultBranchRef,url",
    "github:issues": "gh issue list --repo ameisw667/Casino --state open --limit 20 --json number,title,state,updatedAt,url",
    "github:prs": "gh pr list --repo ameisw667/Casino --state open --limit 20 --json number,title,author,state,updatedAt,url",
    "github:actions": "gh run list --repo ameisw667/Casino --limit 20 --json databaseId,displayTitle,status,conclusion,workflowName,headBranch,updatedAt,url",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,mjs,json,css}\" \"scripts/**/*.{ts,js,mjs}\" \"tests/**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,mjs,json,css}\" \"scripts/**/*.{ts,js,mjs}\" \"tests/**/*.{ts,tsx,js}\"",
    "check-doc-links": "node scripts/check-doc-links.mjs",
    "check-secret-rotation": "tsx scripts/check-secret-rotation-due.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "node scripts/typecheck-staged.mjs",
      "prettier --write"
    ],
    "*.{js,mjs,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@playwright/test": "1.62.1",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.4",
    "@trigger.dev/react-hooks": "4.5.12",
    "@trigger.dev/sdk": "4.5.12",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "posthog-js": "^1.417.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "web-vitals": "5.3.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "^1.0.1",
    "@trigger.dev/build": "4.5.12",
    "@types/d3-color": "^3.1.3",
    "@types/d3-path": "^3.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.6",
    "artillery": "^2.0.33",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "is-number": "^7.0.0",
    "isarray": "^2.0.5",
    "isexe": "^2.0.0",
    "jsdom": "^29.1.1",
    "json-schema-traverse": "^1.0.0",
    "json-stable-stringify-without-jsonify": "^1.0.1",
    "lint-staged": "^16.4.0",
    "lodash.merge": "^4.6.2",
    "madge": "^8.0.0",
    "natural-compare": "^1.4.0",
    "object-assign": "^4.1.1",
    "object-keys": "^1.1.1",
    "parent-module": "^3.2.0",
    "path-exists": "^5.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-is": "^19.2.7",
    "resolve-from": "^5.0.0",
    "shebang-regex": "^4.0.0",
    "strip-bom": "^5.0.0",
    "supabase": "2.116.0",
    "to-regex-range": "^5.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
