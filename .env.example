# Supabase — dediziertes Casino-Projekt, keine geteilte Master-DB
# Pflicht — Boot bricht mit einem `[env]`-Fehler ab, wenn eine dieser 3 Variablen fehlt oder
# ungültig ist (src/lib/env.ts, assertCoreEnv(), aufgerufen aus src/instrumentation.ts).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth (für Supabase Auth — muss zusätzlich im Supabase-Dashboard unter
# Authentication > Providers > Google hinterlegt werden, wird nicht automatisch
# aus diesen Variablen gelesen)
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Authorization: comma-separated emails, case-insensitive; server-only, never NEXT_PUBLIC_*
SUPABASE_ADMIN_EMAILS=admin@example.com

# Upstash Redis: required in production; development uses an in-memory fallback
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Server-only AI: used by /api/chat/bot-response AND the manual design-asset generator
# (scripts/generate-design-assets.ts, see docs/images/00_IMAGES_OVERVIEW.md). Never expose
# as NEXT_PUBLIC_*.
OPENAI_API_KEY=your_openai_api_key

# Design-Asset-Generierung (optional — Defaults greifen, wenn nicht gesetzt): manuelles
# Dev-Tool, nie automatisch vom LLM ausgeloest. Siehe docs/images/02_cost_usage_governance.md.
# DESIGN_ASSETS_MAX_SPEND_USD=5
# DESIGN_ASSETS_EST_COST_PER_IMAGE_USD=0.25

# Server-only Royale Guide observability. Generate a unique random value with at least 32 bytes.
# Never commit the real secret or expose it via a NEXT_PUBLIC_* variable.
GUIDE_TELEMETRY_HMAC_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes
GUIDE_TELEMETRY_HMAC_VERSION=1

# Shared secret between the pg_cron purge job (via pg_net) and the internal
# /api/internal/cron-alert route. Generate a unique random value with at least 32 bytes.
CRON_ALERT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV wird von Next.js automatisch gesetzt (production bei build, development bei dev)
# Hier NICHT setzen — es bricht sonst next build (bekannter Next.js 16 Bug)

# Dev-only: erlaubt unauthentifizierte Bet-Requests im Entwicklungsmodus
# ALLOW_DEV_FALLBACK=true

# Sentry (1.9 Applikationsweites Error-Tracking, siehe worldmap/05_1.9)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org_slug
SENTRY_PROJECT=your_sentry_project_slug
# Optional: nur für lesbare Stack-Traces (Source-Map-Upload beim Build), server/build-only
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Telegram Big-Win-Benachrichtigungen (2.2). Server-only, nie als NEXT_PUBLIC_* — nur der
# Bot-Username ist öffentlich. TELEGRAM_WEBHOOK_SECRET ist ein selbst gewählter, zufälliger
# Wert (mind. 32 Bytes), der 1:1 beim `setWebhook`-Aufruf als `secret_token` mitgegeben wird.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot_username

# PostHog Product Analytics (2.9). Project token is PostHog's own public/client-safe key
# (safe to embed in client bundles), NEXT_PUBLIC_* required so Next.js inlines it client-side.
# See worldmap/05_2.9_PostHog_Analytics.md.
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_instance_host
# Server-only, generated at M8 implementation time. Never commit the real secret or expose it
# via a NEXT_PUBLIC_* variable. Generate a unique random value with at least 32 bytes.
POSTHOG_DISTINCT_ID_HMAC_SECRET=replace_with_a_unique_random_secret_of_at_least_32_bytes
# M11 erasure (posthog-erasure.ts). Project ID from the PostHog project settings page.
POSTHOG_PROJECT_ID=your_posthog_project_id
# Personal API Key with the "person:write" scope (PostHog > Settings > Personal API Keys) —
# different from NEXT_PUBLIC_POSTHOG_KEY above, never public. Leave unset to keep erasure inert.
POSTHOG_PERSONAL_API_KEY=your_posthog_personal_api_key_with_person_write_scope

# Offsite-Backup-Pipeline (Säule 9, `npm run backup:run` → scripts/backup-supabase.ts).
# Server-only, nie NEXT_PUBLIC_*. Ohne diese Variablen bricht `backup:run` fail-closed ab,
# bevor CLI oder S3 aufgerufen werden. Echter Zugriffsschlüssel: nur Rechte auf den
# Backup-Präfix (Upload/Download/Listing, KEIN Delete — Retention läuft über die
# Bucket-Lifecycle-Regel). Siehe T_DATABASE/05_database_backup_and_recovery.md.
BACKUP_ENCRYPTION_KEY_BASE64=base64_encoded_32_byte_random_key
BACKUP_S3_ENDPOINT=https://your_s3_compatible_endpoint.example.com
BACKUP_S3_BUCKET=your_backup_bucket_name
BACKUP_S3_REGION=your_bucket_region
BACKUP_S3_ACCESS_KEY_ID=your_backup_prefix_scoped_access_key_id
BACKUP_S3_SECRET_ACCESS_KEY=your_backup_prefix_scoped_secret_access_key
# Optional: Upload-Präfix (Default: casino-recovery)
# BACKUP_S3_PREFIX=casino-recovery
# Optional: nur bei nachgewiesenen Custom Roles auf true setzen (schema dump umfasst --role-only)
# BACKUP_INCLUDE_ROLES=false
# Optional: reserviert für künftige Key-Rotation (Manifest-Key-Version; im Code noch nicht verdrahtet)
# BACKUP_ENCRYPTION_KEY_VERSION=1
