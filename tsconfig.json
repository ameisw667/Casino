{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".next/cache/tsconfig.tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "trigger.config.ts",
    ".next-k6a-build/types/**/*.ts",
    ".next-k6a-build/dev/types/**/*.ts",
    ".next-mobile-lcp-exec-dice-final/types/**/*.ts",
    ".next-mobile-lcp-exec-dice-final/dev/types/**/*.ts",
    ".next-analytics-verify/types/**/*.ts",
    ".next-analytics-verify/dev/types/**/*.ts",
    ".next-mobile-lcp-exec-crash-mp-diagnosis/types/**/*.ts",
    ".next-mobile-lcp-exec-crash-mp-diagnosis/dev/types/**/*.ts",
    ".next-mobile-lcp-exec-crash-mp-layout-final/types/**/*.ts",
    ".next-mobile-lcp-exec-crash-mp-layout-final/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "remotion-ad", "workspace/media/remotion-ad"]
}
