# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# next.js isolated build artifact dirs from performance/verification runs (regenerable —
# each is a separate out-dir passed to next build; mirrors the `.next*/**` eslint ignore)
/.next-*
*.pid
/.supabase-status.env
/lighthouse-*-report.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files; the safe template is versioned deliberately
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# temporary local reports
*.txt
eslint_report.json
tsconfig.staged-*.json
scratch/
errors/
/database/
PRE_PUSH_TEST_PLAN.md
CASINO_DEBUDGING_CHECKLIST.md
CASINO_COMMUNITY_CHECKLIST.md
CASINO_ULTIMATE_MASTER_PLAN.md

.gstack/
.superpowers/
test-results/
.playwright-mcp/

# claude code
.claude/worktrees/



# supabase (local CLI artifacts)
/supabase/.temp/

# sentry-cli (local, project-scoped auth token from `sentry-cli login`)
.sentryclirc

# one-shot rollout/verify scripts (keep verify-migrations-applied.sql committed)
scripts/_tmp_*
.qa-tmp/

# local scratch/build directories (never commit)
Workroom/
web/
.env*

.trigger

# planning docs are tracked for durability since 2026-08-29 (worldmap/06_planungsdatei_versionierung.md).
# .research/ stays excluded: vendored third-party research clones (e.g. a full external repo
# checkout with its own nested .git) — never track without stripping the nested .git first.
/worldmap/.research/

# remotion-ad: local Remotion experiment by Jan (own npm package, testing only)
/remotion-ad/
/workspace/media/remotion-ad/

# shared skills: NTFS directory junction to v:/VibeCoding/.claude/skills.
# Deliberately TRACKED since 2026-09-17 (G5 Option A, T_REPO_HYGIENE/Planungsdateien/02):
# xx_sop/01-03 and two T_FRONTEND files link the canonical SKILL.md paths, and a CI clone
# has no junction — an unversioned target is a permanently dead live link. Trade-off
# accepted: edits in the junction target surface here as modified tracked files.

# image-generation scratch output (regenerable; committed generated assets live in public/generated/)
/output/
/workspace/output/

# dependency-audit.yml local reruns (regenerable; CI uploads sbom.json as a build artifact instead
# of committing it — docs/security-hardening/07_dependency_supply_chain_audit.md)
/audit-moderate.json
/sbom.json
